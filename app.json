{
  "expo": {
    "name": "Fashion Scene",
    "slug": "fashion-scene",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fashion-scene-logo.png",
    "scheme": "fashionscene",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/fashion-scene-logo.png"
    },
    "android": {
      "package": "com.fahionscene.fashionscene",
      "adaptiveIcon": {
        "backgroundColor": "#FFA200",
        "foregroundImage": "./assets/images/fashion-scene-logo.png",
        "monochromeImage": "./assets/images/fashion-scene-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fashion-scene-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/fashion-scene-logo.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/05f387e5-2e2b-41af-920b-58e65fc75551"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "05f387e5-2e2b-41af-920b-58e65fc75551"
      }
    }
  }
}
